 <Window x:Class="XakaLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XakaLauncher" Height="720" Width="1120" MinHeight="650" MinWidth="980"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}"
        Foreground="#F8F3FF">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E9D9FF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="XAKA" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PinkBrush}" />
                <TextBlock Text="LAUNCHER" FontSize="34" FontWeight="ExtraBold" Foreground="White">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#B45CFF" BlurRadius="18" ShadowDepth="0" Opacity="0.75"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="ТВОЙ MINECRAFT. ТВОИ ПРАВИЛА." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="2,3,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="СКАЧАТЬ" Click="OpenDownloads_Click" Padding="18,11" Margin="0,0,10,0"
                        Background="#39234D" BorderBrush="#C45BFF" Foreground="#F7DFFF" FontWeight="Bold"/>
                <Button Content="MODS" Click="OpenModsFolder_Click" Padding="18,11" Margin="0,0,10,0"
                        Background="#39234D" BorderBrush="#C45BFF" Foreground="#F7DFFF" FontWeight="Bold"/>
                <Button Content="RESOURCE PACKS" Click="OpenResourcePacksFolder_Click" Padding="18,11" Margin="0,0,10,0"
                        Background="#39234D" BorderBrush="#C45BFF" Foreground="#F7DFFF" FontWeight="Bold"/>
                <Button Content="НАСТРОЙКИ" Click="OpenSettings_Click" Padding="18,11" Margin="0,0,12,0"
                        Background="#39234D" BorderBrush="#C45BFF" Foreground="#F7DFFF" FontWeight="Bold"/>
                <Border CornerRadius="14" BorderBrush="#593875" BorderThickness="1" Background="#211831" Padding="14,9">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#FF4FCB" Margin="0,0,9,0"/>
                        <TextBlock Text="BETA • BUILD 0.1" Foreground="#E8D5FF" FontSize="11" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="#39264F"
                    BorderThickness="1" CornerRadius="18" Padding="24">
                <StackPanel>
                    <TextBlock Text="ПРОФИЛЬ ИГРОКА" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Никнейм" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,6"/>
                    <TextBox x:Name="NicknameBox" Text="Player" MaxLength="16"/>
                    <TextBlock Text="Офлайн-профиль: ник без входа Microsoft. Он подходит только для локальной игры и серверов, разрешающих такой вход."
                               Style="{StaticResource Hint}" Margin="0,8,0,22"/>

                    <TextBlock Text="ВЕРСИЯ И ЗАГРУЗЧИК" Style="{StaticResource SectionTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Minecraft" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,6"/>
                            <ComboBox x:Name="VersionBox" SelectedIndex="0">
                                <ComboBoxItem Content="1.21.4"/>
                                <ComboBoxItem Content="1.21.1"/>
                                <ComboBoxItem Content="1.20.1"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Загрузчик" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,6"/>
                            <ComboBox x:Name="LoaderBox" SelectedIndex="0">
                                <ComboBoxItem Content="Vanilla"/>
                                <ComboBoxItem Content="Fabric"/>
                                <ComboBoxItem Content="Forge"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Установка выбранных версий и загрузчиков будет подключена следующим этапом."
                               Style="{StaticResource Hint}" Margin="0,8,0,22"/>

                    <TextBlock Text="ПАПКА ИГРЫ" Style="{StaticResource SectionTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="GameFolderBox" Grid.Column="0" IsReadOnly="True"/>
                        <Button Grid.Column="2" Content="ОБЗОР" Click="BrowseFolder_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="#39264F"
                    BorderThickness="1" CornerRadius="18" Padding="24">
                <StackPanel>
                    <TextBlock Text="ПАРАМЕТРЫ ЗАПУСКА" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Оперативная память для Minecraft" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    <TextBlock x:Name="RamValueText" Text="4 ГБ" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource PinkBrush}" Margin="0,7,0,2"/>
                    <TextBlock Text="Изменить выделение ОЗУ можно в разделе «Настройки». Максимум — 10 ГБ."
                               Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,22"/>
                    <Slider x:Name="RamSlider" Minimum="2" Maximum="10" Value="4" TickFrequency="1"
                            IsSnapToTickEnabled="True" Visibility="Collapsed"/>

                    <TextBlock Text="JAVA" Style="{StaticResource SectionTitle}"/>
                    <TextBlock x:Name="JavaStatusText" Text="Java ещё не проверена" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Button Content="ПРОВЕРИТЬ JAVA" Click="CheckJava_Click" HorizontalAlignment="Left" Margin="0,0,0,24"/>

                    <TextBlock Text="СОСТОЯНИЕ" Style="{StaticResource SectionTitle}"/>
                    <Border Background="#120E1D" BorderBrush="#49345F" BorderThickness="1" CornerRadius="10" Padding="12">
                        <TextBlock x:Name="StatusText" Text="Ожидание настройки" Foreground="#D7C5EA"
                                   TextWrapping="Wrap" MinHeight="48"/>
                    </Border>
                    <TextBlock Text="XakaLauncher не отправляет телеметрию и не собирает HWID. Настройки хранятся локально."
                               Style="{StaticResource Hint}" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="СЛЕДУЮЩИЙ ЭТАП: УСТАНОВКА И ЗАПУСК ИГРЫ" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
                <TextBlock Text="Кнопка запуска появится после подключения безопасной загрузки игровых файлов."
                           Foreground="#C8B8D8" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Content="ИГРАТЬ — СКОРО" IsEnabled="False" Width="220" Height="54"
                    HorizontalAlignment="Right" FontSize="15" Background="#49345F" BorderBrush="#77549B"/>
        </Grid>
    </Grid>
</Window>